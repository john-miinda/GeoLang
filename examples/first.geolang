language GeoLang

let standard_radius = 7
let triangle_base = 10
let triangle_height = 6
let rectangle_length = 12
let rectangle_width = 5
let square_side = 4

circle sample_circle radius = standard_radius
triangle sample_triangle base = triangle_base height = triangle_height
rectangle sample_rectangle length = rectangle_length width = rectangle_width
square sample_square side = square_side

calculate sample_circle
calculate sample_triangle
calculate sample_rectangle
calculate sample_square
